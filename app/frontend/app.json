{
  "expo": {
    "name": "OurSpace",
    "slug": "soulsync",
    "owner": "mait1999s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "soulsync",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050510"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.soulsync.app"
    },
    "android": {
      "edgeToEdgeEnabled": false,
      "package": "com.soulsync.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#E8607A",
          "sounds": [
            "./assets/sounds/chime.wav"
          ]
        }
      ],
      "expo-web-browser",
      "./plugins/withMetaInfExclude"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "backendUrl": "http://localhost:8001",
      "router": {},
      "eas": {
        "projectId": "628d75cf-955b-45ac-8c0c-5f221c30437a"
      }
    }
  }
}
